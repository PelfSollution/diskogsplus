# ------------------------------------------------------------------------------
# DISKOGS PLUS - VARIABLES DE ENTORNO
# ------------------------------------------------------------------------------

# Entorno y URLs base
BASE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Clave secreta para cifrado local AES (cookies y datos sensibles)
# Genera una cadena aleatoria segura para producción
CRYPT_KEY=cambia_esta_clave_secreta_por_una_segura_32char

# Discogs API (OAuth 1.0a)
# Obtenidas en https://www.discogs.com/settings/developers
CONSUMER_KEY=
CONSUMER_SECRET=

# Google AI Studio (Gemini API) - RECOMENDADO (Gratuito y sin tarjeta)
# Obtén tu clave en: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (opcional, alternativa a Gemini)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Spotify API (para metadatos de audio, BPM, Camelot y Mixtapes)
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Last.fm API (para artistas similares e info biográfica)
# https://www.last.fm/api/account/create
LASTFM_API_KEY=

# YouTube Data API v3 (buscar el álbum completo de YouTube Music de cada disco)
# https://console.cloud.google.com/apis/credentials (gratis, 10.000 unidades/día)
YOUTUBE_API_KEY=

# Supabase (base de datos para usuarios, wantlist, mixtapes y chat logs)
# https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=